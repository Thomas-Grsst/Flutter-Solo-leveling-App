      {
        "selector": "JSXOpeningElement[name.name='Loader'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|inline|tone|style|key|ref|className|style|children)$/]",
        "message": "<Loader> doesn't accept that prop. Declared props: size, label, inline, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|neutral)$/]",
        "message": "<Loader> tone must be one of 'accent' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|title|subtitle|danger|children|footer|onClose|overlay|width|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: size, title, subtitle, danger, children, footer, onClose, overlay, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|large)$/]",
        "message": "<Modal> size must be one of 'small' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|time|tone|icon|unread|action|group|key|ref|className|style|children)$/]",
        "message": "<NotificationItem> doesn't accept that prop. Declared props: title, detail, time, tone, icon, unread, action, group."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|err|info)$/]",
        "message": "<NotificationItem> tone must be one of 'ok' | 'warn' | 'err' | 'info'."
      },
