        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|total|page|pages|onPage|pageSize|pageSizes|pageSizeVariant|onPageSize|style|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: from, to, total, page, pages, onPage, pageSize, pageSizes, pageSizeVariant, onPageSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute[name.name='pageSizeVariant'] > Literal[value!=/^(?:dropdown|segmented|none)$/]",
        "message": "<Pagination> pageSizeVariant must be one of 'dropdown' | 'segmented' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Agency'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|code|clients|checked|key|ref|className|style|children)$/]",
        "message": "<Agency> doesn't accept that prop. Declared props: name, code, clients, checked."
