        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='edge'] > Literal[value!=/^(?:left|top)$/]",
        "message": "<KpiCard> edge must be one of 'left' | 'top'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|crit)$/]",
        "message": "<KpiCard> tone must be one of 'ok' | 'warn' | 'crit'."
