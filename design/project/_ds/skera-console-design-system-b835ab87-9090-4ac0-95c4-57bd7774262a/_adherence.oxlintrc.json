{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/datatable/**",
              "components/datepicker/**",
              "components/feedback/**",
              "components/filters/**",
              "components/forms/**",
              "components/navigation/**",
              "components/notifications/**",
              "components/overlays/**",
              "components/search/**",
              "components/states/**",
              "components/stepper/**",
              "components/table/**",
              "extracted/**",
              "ui_kits/console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|destructive|destructiveGhost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'destructive' | 'destructiveGhost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:edge|bento|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: edge, bento, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='edge'] > Literal[value!=/^(?:signal|ok|warn|crit|info)$/]",
        "message": "<Card> edge must be one of 'signal' | 'ok' | 'warn' | 'crit' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, disabled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnDef'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|visible|locked|dragging|key|ref|className|style|children)$/]",
        "message": "<ColumnDef> doesn't accept that prop. Declared props: label, visible, locked, dragging."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaletteItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|code|meta|right|chevron|active|key|ref|className|style|children)$/]",
        "message": "<PaletteItem> doesn't accept that prop. Declared props: icon, title, code, meta, right, chevron, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContextMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|shortcut|destructive|hover|onClick|key|ref|className|style|children)$/]",
        "message": "<ContextMenuItem> doesn't accept that prop. Declared props: label, icon, shortcut, destructive, hover, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|sortable|strong|mono|render|key|ref|className|style|children)$/]",
        "message": "<DataColumn> doesn't accept that prop. Declared props: key, label, align, sortable, strong, mono, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DataColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DatePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|month|value|rangeEnd|today|open|label|presets|style|key|ref|className|style|children)$/]",
        "message": "<DatePicker> doesn't accept that prop. Declared props: year, month, value, rangeEnd, today, open, label, presets, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|help|primary|secondary|code|compact|onPrimary|onSecondary|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: kind, title, help, primary, secondary, code, compact, onPrimary, onSecondary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:empty|blank|unreachable|denied|error)$/]",
        "message": "<EmptyState> kind must be one of 'empty' | 'blank' | 'unreachable' | 'denied' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|hint|error|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, required, hint, error, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:filters|onClearAll|onAdd|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<FilterBar> doesn't accept that prop. Declared props: filters, onClearAll, onAdd, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterCategory'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|key|ref|className|style|children)$/]",
        "message": "<FilterCategory> doesn't accept that prop. Declared props: label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterToken'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|active|onClick|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<FilterToken> doesn't accept that prop. Declared props: name, value, active, onClick, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Gauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|tone|showValue|style|key|ref|className|style|children)$/]",
        "message": "<Gauge> doesn't accept that prop. Declared props: label, value, max, tone, showValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Gauge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|g|o|r)$/]",
        "message": "<Gauge> tone must be one of 'accent' | 'g' | 'o' | 'r'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImpersonationBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:user|onQuit|style|key|ref|className|style|children)$/]",
        "message": "<ImpersonationBanner> doesn't accept that prop. Declared props: user, onQuit, style."
      },
      {
